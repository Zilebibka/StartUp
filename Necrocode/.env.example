# Copy this file to .env and adjust if needed.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=necrocode

# Public HTTP port for Nginx frontend container
WEB_PORT=80

# Browser origin used by backend CORS
CORS_ORIGIN=http://localhost

# Set a strong random secret in production
JWT_SECRET=change-me-to-a-long-random-secret

# true when app is served via HTTPS (recommended in production)
COOKIE_SECURE=false

# SMTP settings for sending verification/reset codes
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USERNAME=login@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=login@example.com
